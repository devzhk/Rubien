DEFINE SCHEMA

    RECORD TYPE CDAssistantActivity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        epochRevision   INT64 QUERYABLE SORTABLE,
        generation      STRING QUERYABLE SEARCHABLE SORTABLE,
        localDay        STRING QUERYABLE SEARCHABLE SORTABLE,
        provider        STRING QUERYABLE SEARCHABLE SORTABLE,
        startedAt       TIMESTAMP QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDActivityEpoch (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        generation      STRING QUERYABLE SEARCHABLE SORTABLE,
        kind            STRING QUERYABLE SEARCHABLE SORTABLE,
        resetAt         TIMESTAMP QUERYABLE SORTABLE,
        revision        INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDDatabaseView (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        columnWrapsJSON STRING QUERYABLE SEARCHABLE SORTABLE,
        columnsJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        dateCreated     TIMESTAMP QUERYABLE SORTABLE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        displayOrder    INT64 QUERYABLE SORTABLE,
        filtersJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        groupByJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        icon            STRING QUERYABLE SEARCHABLE SORTABLE,
        isDefault       INT64 QUERYABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        scopeJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        sortsJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDMetadataEvidence (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        bundleHash      STRING QUERYABLE SEARCHABLE SORTABLE,
        createdAt       TIMESTAMP QUERYABLE SORTABLE,
        fetchMode       STRING QUERYABLE SEARCHABLE SORTABLE,
        intakeId        INT64 QUERYABLE SORTABLE,
        payloadJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        recordKey       STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceId     INT64 QUERYABLE SORTABLE,
        source          STRING QUERYABLE SEARCHABLE SORTABLE,
        sourceURL       STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDMetadataIntake (
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE,
        candidatesJSON        STRING QUERYABLE SEARCHABLE SORTABLE,
        createdAt             TIMESTAMP QUERYABLE SORTABLE,
        currentReferenceJSON  STRING QUERYABLE SEARCHABLE SORTABLE,
        evidenceBundleHash    STRING QUERYABLE SEARCHABLE SORTABLE,
        fallbackReferenceJSON STRING QUERYABLE SEARCHABLE SORTABLE,
        linkedReferenceId     INT64 QUERYABLE SORTABLE,
        originalInput         STRING QUERYABLE SEARCHABLE SORTABLE,
        pdfPath               STRING QUERYABLE SEARCHABLE SORTABLE,
        seedJSON              STRING QUERYABLE SEARCHABLE SORTABLE,
        sourceKind            STRING QUERYABLE SEARCHABLE SORTABLE,
        sourceURL             STRING QUERYABLE SEARCHABLE SORTABLE,
        statusMessage         STRING QUERYABLE SEARCHABLE SORTABLE,
        title                 STRING QUERYABLE SEARCHABLE SORTABLE,
        updatedAt             TIMESTAMP QUERYABLE SORTABLE,
        verificationStatus    STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDPDFAnnotation (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        boundsHeight    DOUBLE QUERYABLE SORTABLE,
        boundsWidth     DOUBLE QUERYABLE SORTABLE,
        boundsX         DOUBLE QUERYABLE SORTABLE,
        boundsY         DOUBLE QUERYABLE SORTABLE,
        color           STRING QUERYABLE SEARCHABLE SORTABLE,
        dateCreated     TIMESTAMP QUERYABLE SORTABLE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        noteText        STRING QUERYABLE SEARCHABLE SORTABLE,
        pageIndex       INT64 QUERYABLE SORTABLE,
        rectsData       STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceId     INT64 QUERYABLE SORTABLE,
        selectedText    STRING QUERYABLE SEARCHABLE SORTABLE,
        type            STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDPropertyDefinition (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        defaultFieldKey STRING QUERYABLE SEARCHABLE SORTABLE,
        isDefault       INT64 QUERYABLE SORTABLE,
        isVisible       INT64 QUERYABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        optionsJSON     STRING QUERYABLE SEARCHABLE SORTABLE,
        sortOrder       INT64 QUERYABLE SORTABLE,
        type            STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDPropertyValue (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        propertyId      INT64 QUERYABLE SORTABLE,
        referenceId     INT64 QUERYABLE SORTABLE,
        value           STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDReadingActivity (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        activeSeconds   INT64 QUERYABLE SORTABLE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        epochRevision   INT64 QUERYABLE SORTABLE,
        generation      STRING QUERYABLE SEARCHABLE SORTABLE,
        installationId  STRING QUERYABLE SEARCHABLE SORTABLE,
        lastActiveAt    TIMESTAMP QUERYABLE SORTABLE,
        localDay        STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceId     INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDReference (
        "___createTime"       TIMESTAMP,
        "___createdBy"        REFERENCE,
        "___etag"             STRING,
        "___modTime"          TIMESTAMP,
        "___modifiedBy"       REFERENCE,
        "___recordID"         REFERENCE,
        abstract              STRING QUERYABLE SEARCHABLE SORTABLE,
        acceptedByRuleID      STRING QUERYABLE SEARCHABLE SORTABLE,
        accessedDate          STRING QUERYABLE SEARCHABLE SORTABLE,
        authorsJSON           STRING QUERYABLE SEARCHABLE SORTABLE,
        collectionTitle       STRING QUERYABLE SEARCHABLE SORTABLE,
        dateAdded             TIMESTAMP QUERYABLE SORTABLE,
        dateModified          TIMESTAMP QUERYABLE SORTABLE,
        doi                   STRING QUERYABLE SEARCHABLE SORTABLE,
        edition               STRING QUERYABLE SEARCHABLE SORTABLE,
        editorsJSON           STRING QUERYABLE SEARCHABLE SORTABLE,
        eventPlace            STRING QUERYABLE SEARCHABLE SORTABLE,
        eventTitle            STRING QUERYABLE SEARCHABLE SORTABLE,
        evidenceBundleHash    STRING QUERYABLE SEARCHABLE SORTABLE,
        favicon               STRING QUERYABLE SEARCHABLE SORTABLE,
        genre                 STRING QUERYABLE SEARCHABLE SORTABLE,
        institution           STRING QUERYABLE SEARCHABLE SORTABLE,
        isbn                  STRING QUERYABLE SEARCHABLE SORTABLE,
        issn                  STRING QUERYABLE SEARCHABLE SORTABLE,
        issue                 STRING QUERYABLE SEARCHABLE SORTABLE,
        issuedDay             INT64 QUERYABLE SORTABLE,
        issuedMonth           INT64 QUERYABLE SORTABLE,
        journal               STRING QUERYABLE SEARCHABLE SORTABLE,
        language              STRING QUERYABLE SEARCHABLE SORTABLE,
        lastReadAt            TIMESTAMP QUERYABLE SORTABLE,
        metadataSource        STRING QUERYABLE SEARCHABLE SORTABLE,
        notes                 STRING QUERYABLE SEARCHABLE SORTABLE,
        number                STRING QUERYABLE SEARCHABLE SORTABLE,
        numberOfPages         STRING QUERYABLE SEARCHABLE SORTABLE,
        pages                 STRING QUERYABLE SEARCHABLE SORTABLE,
        pmcid                 STRING QUERYABLE SEARCHABLE SORTABLE,
        pmid                  STRING QUERYABLE SEARCHABLE SORTABLE,
        publisher             STRING QUERYABLE SEARCHABLE SORTABLE,
        publisherPlace        STRING QUERYABLE SEARCHABLE SORTABLE,
        readCount             INT64 QUERYABLE SORTABLE,
        readingStatus         STRING QUERYABLE SEARCHABLE SORTABLE,
        recordKey             STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceType         STRING QUERYABLE SEARCHABLE SORTABLE,
        reviewedBy            STRING QUERYABLE SEARCHABLE SORTABLE,
        siteName              STRING QUERYABLE SEARCHABLE SORTABLE,
        title                 STRING QUERYABLE SEARCHABLE SORTABLE,
        translatorsJSON       STRING QUERYABLE SEARCHABLE SORTABLE,
        url                   STRING QUERYABLE SEARCHABLE SORTABLE,
        verificationSourceURL STRING QUERYABLE SEARCHABLE SORTABLE,
        verificationStatus    STRING QUERYABLE SEARCHABLE SORTABLE,
        verifiedAt            TIMESTAMP QUERYABLE SORTABLE,
        volume                STRING QUERYABLE SEARCHABLE SORTABLE,
        webContent            STRING QUERYABLE SEARCHABLE SORTABLE,
        year                  INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDReferencePDF (
        "___createTime"  TIMESTAMP,
        "___createdBy"   REFERENCE,
        "___etag"        STRING,
        "___modTime"     TIMESTAMP,
        "___modifiedBy"  REFERENCE,
        "___recordID"    REFERENCE,
        asset            ASSET,
        assetVersion     INT64 QUERYABLE SORTABLE,
        contentHash      STRING QUERYABLE SEARCHABLE SORTABLE,
        dateModified     TIMESTAMP QUERYABLE SORTABLE,
        originalFilename STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceId      INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDReferenceTag (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        referenceId     INT64 QUERYABLE SORTABLE,
        tagId           INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDTag (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        color           STRING QUERYABLE SEARCHABLE SORTABLE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CDWebAnnotation (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        anchorText      STRING QUERYABLE SEARCHABLE SORTABLE,
        color           STRING QUERYABLE SEARCHABLE SORTABLE,
        dateCreated     TIMESTAMP QUERYABLE SORTABLE,
        dateModified    TIMESTAMP QUERYABLE SORTABLE,
        noteText        STRING QUERYABLE SEARCHABLE SORTABLE,
        prefixText      STRING QUERYABLE SEARCHABLE SORTABLE,
        referenceId     INT64 QUERYABLE SORTABLE,
        selectedText    STRING QUERYABLE SEARCHABLE SORTABLE,
        suffixText      STRING QUERYABLE SEARCHABLE SORTABLE,
        type            STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
